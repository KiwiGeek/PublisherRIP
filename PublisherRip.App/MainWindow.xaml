<Window x:Class="PublisherRip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:PublisherRip.App.Models"
        mc:Ignorable="d"
        Title="Publisher RIP"
        Width="420"
        Height="640"
        MinWidth="380"
        MinHeight="460"
        Background="#FFF7F3EE"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        AllowDrop="True"
        PreviewDragOver="HandlePreviewDragOver"
        PreviewDrop="HandlePreviewDrop">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFCF8" />
        <SolidColorBrush x:Key="BorderBrushStrong" Color="#FFD6B48A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFC65D1A" />
        <SolidColorBrush x:Key="AccentBrushDark" Color="#FF8C3B0B" />
        <SolidColorBrush x:Key="TextBrush" Color="#FF2D2118" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF6C5847" />

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrushDark}" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrushStrong}"
                                Background="{StaticResource PanelBrush}"
                                Padding="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFFCE7D2" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushStrong}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="16"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Publisher RIP"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Drop images, PDFs, or Outlook attachments here. The window stays on top so you can fling pages into it fast."
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="#FFFCE7D2"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="2"
                CornerRadius="18"
                Padding="18"
                Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Drop Zone"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource AccentBrushDark}" />
                <TextBlock Text="Drag files anywhere into this window."
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding Pages}"
                     SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:PrintPageItem}">
                        <DockPanel LastChildFill="True">
                            <Border Width="74"
                                    Height="98"
                                    CornerRadius="10"
                                    Background="#FFF2E6D7"
                                    BorderBrush="#FFE2C8A9"
                                    BorderThickness="1"
                                    Margin="0,0,12,0">
                                <Image Source="{Binding Preview}"
                                       Stretch="Uniform"
                                       Margin="6" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding PageLabel}"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding SourceLabel}"
                                           Margin="0,2,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Background="#66F7F3EE"
                    CornerRadius="16"
                    Padding="24"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Your queued pages will show up here."
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Border>
        </Grid>

        <WrapPanel Grid.Row="3" Margin="0,12,0,4">
            <Button Content="Move Up"
                    Click="MoveUpClicked"
                    IsEnabled="{Binding CanMoveUp}" />
            <Button Content="Move Down"
                    Click="MoveDownClicked"
                    IsEnabled="{Binding CanMoveDown}" />
            <Button Content="Remove"
                    Click="RemoveClicked"
                    IsEnabled="{Binding HasSelection}" />
            <Button Content="Clear All"
                    Click="ClearAllClicked"
                    IsEnabled="{Binding HasPages}" />
            <Button Content="Print"
                    Click="PrintClicked"
                    IsEnabled="{Binding CanPrint}"
                    Style="{StaticResource AccentButtonStyle}" />
        </WrapPanel>

        <DockPanel Grid.Row="4" Margin="0,4,0,0">
            <TextBlock Text="{Binding StatusText}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedTextBrush}"
                       DockPanel.Dock="Left" />
            <TextBlock Text="{Binding PageCountLabel}"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource AccentBrushDark}" />
        </DockPanel>
    </Grid>
</Window>
