<Window x:Class="PublisherRip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:PublisherRip.App.Models"
        mc:Ignorable="d"
        Title="Publisher RIP"
        Icon="Assets/PublisherRip.ico"
        Width="420"
        Height="640"
        MinWidth="380"
        MinHeight="460"
        Background="{DynamicResource WindowBackgroundBrush}"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        AllowDrop="True"
        PreviewDragOver="HandlePreviewDragOver"
        PreviewDrop="HandlePreviewDrop">
    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrushStrong}"
                                Background="{DynamicResource PanelBrush}"
                                Padding="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HighlightBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrushStrong}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Publisher RIP"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="Drop images, PDFs, or Outlook attachments here. The window stays on top so you can fling pages into it fast."
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <Button x:Name="SettingsButton"
                        Grid.Column="1"
                        Click="SettingsClicked"
                        Margin="8,0,0,0"
                        Padding="6"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="Settings"
                        AutomationProperties.Name="Settings">
                    <TextBlock Text="&#xE713;" Style="{StaticResource ActionIconStyle}" Margin="0" Foreground="{DynamicResource MutedTextBrush}" />
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="RestartToUpdateMenuItem"
                                      Header="Restart to update"
                                      FontWeight="SemiBold"
                                      Visibility="Collapsed"
                                      Click="RestartToUpdateClicked" />
                            <MenuItem x:Name="CheckForUpdatesMenuItem"
                                      Header="Check for updates"
                                      Click="CheckForUpdatesClicked" />
                            <MenuItem x:Name="InstallOptionsMenuItem"
                                      Header="Shortcuts and command-line launcher…"
                                      Click="InstallOptionsClicked" />
                            <Separator />
                            <MenuItem x:Name="VersionMenuItem"
                                      Header="Development build"
                                      IsEnabled="False" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource HighlightBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="2"
                CornerRadius="18"
                Padding="18"
                Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="&#xE898;"
                           Style="{StaticResource ActionIconStyle}"
                           FontSize="28"
                           Margin="0,0,0,8"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentTextBrush}" />
                <TextBlock Text="Drop Zone"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentTextBrush}" />
                <TextBlock Text="Drag files anywhere into this window."
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding Pages}"
                     SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:PrintPageItem}">
                        <DockPanel LastChildFill="True">
                            <Border Width="74"
                                    Height="98"
                                    CornerRadius="10"
                                    Background="{DynamicResource ThumbnailBrush}"
                                    BorderBrush="{DynamicResource ThumbnailBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,12,0">
                                <Image Source="{Binding Preview}"
                                       Stretch="Uniform"
                                       Margin="6">
                                    <Image.LayoutTransform>
                                        <RotateTransform Angle="{Binding RotationAngle}" />
                                    </Image.LayoutTransform>
                                </Image>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding PageLabel}"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{Binding SourceLabel}"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Background="{DynamicResource OverlayBrush}"
                    CornerRadius="16"
                    Padding="24"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Your queued pages will show up here."
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </Border>
        </Grid>

        <WrapPanel Grid.Row="3" Margin="0,12,0,4">
            <Button Click="RotateLeftClicked"
                    IsEnabled="{Binding CanRotate}"
                    ToolTip="Rotate selected page 90&#xB0; counterclockwise"
                    AutomationProperties.Name="Rotate selected page left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7AD;" Style="{StaticResource ActionIconStyle}" />
                    <TextBlock Text="Rotate Left" />
                </StackPanel>
            </Button>
            <Button Click="RotateRightClicked"
                    IsEnabled="{Binding CanRotate}"
                    ToolTip="Rotate selected page 90&#xB0; clockwise"
                    AutomationProperties.Name="Rotate selected page right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7AD;" Style="{StaticResource ActionIconStyle}">
                        <TextBlock.LayoutTransform>
                            <ScaleTransform ScaleX="-1" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                    <TextBlock Text="Rotate Right" />
                </StackPanel>
            </Button>
            <Button Click="MoveUpClicked"
                    IsEnabled="{Binding CanMoveUp}"
                    AutomationProperties.Name="Move selected page up">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74A;" Style="{StaticResource ActionIconStyle}" />
                    <TextBlock Text="Move Up" />
                </StackPanel>
            </Button>
            <Button Click="MoveDownClicked"
                    IsEnabled="{Binding CanMoveDown}"
                    AutomationProperties.Name="Move selected page down">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74B;" Style="{StaticResource ActionIconStyle}" />
                    <TextBlock Text="Move Down" />
                </StackPanel>
            </Button>
            <Button Click="RemoveClicked"
                    IsEnabled="{Binding HasSelection}"
                    AutomationProperties.Name="Remove selected page">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource ActionIconStyle}" />
                    <TextBlock Text="Remove" />
                </StackPanel>
            </Button>
            <Button Click="ClearAllClicked"
                    IsEnabled="{Binding HasPages}"
                    AutomationProperties.Name="Clear all pages">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8E6;" Style="{StaticResource ActionIconStyle}" />
                    <TextBlock Text="Clear All" />
                </StackPanel>
            </Button>
            <Button Click="PrintClicked"
                    IsEnabled="{Binding CanPrint}"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.Name="Print queued pages">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE749;" Style="{StaticResource ActionIconStyle}" />
                    <TextBlock Text="Print" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <!-- Grid, not DockPanel: a left-docked TextBlock is measured with the full width and
             never wraps before the counter, so the two overlapped (#13). -->
        <Grid Grid.Row="4" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding StatusText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding PageCountLabel}"
                       Margin="12,0,0,0"
                       VerticalAlignment="Bottom"
                       Foreground="{DynamicResource AccentTextBrush}" />
        </Grid>
    </Grid>
</Window>
