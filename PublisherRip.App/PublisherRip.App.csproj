<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\PublisherRip.ico</ApplicationIcon>
    <!-- Custom entry point so Velopack can handle install/update hooks before WPF starts. -->
    <StartupObject>PublisherRip.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\PublisherRip.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
