<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- App palette, light. Keys must match Dark.xaml; reference them with DynamicResource. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF7F3EE" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFCF8" />
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#FFD6B48A" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FFC65D1A" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#FF8C3B0B" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF8C3B0B" />
    <SolidColorBrush x:Key="HighlightBrush" Color="#FFFCE7D2" />
    <SolidColorBrush x:Key="ThumbnailBrush" Color="#FFF2E6D7" />
    <SolidColorBrush x:Key="ThumbnailBorderBrush" Color="#FFE2C8A9" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#66F7F3EE" />
    <SolidColorBrush x:Key="TextBrush" Color="#FF2D2118" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF6C5847" />
    <SolidColorBrush x:Key="ButtonHoverOverlayBrush" Color="#14000000" />
    <SolidColorBrush x:Key="ButtonPressedOverlayBrush" Color="#29000000" />
</ResourceDictionary>
