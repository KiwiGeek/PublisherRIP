<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- App palette, dark. Keys must match Light.xaml; reference them with DynamicResource. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1C1714" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FF27201B" />
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#FF5A4532" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FFC65D1A" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#FFE08A4F" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFF0A46C" />
    <SolidColorBrush x:Key="HighlightBrush" Color="#FF3B2819" />
    <SolidColorBrush x:Key="ThumbnailBrush" Color="#FF332A23" />
    <SolidColorBrush x:Key="ThumbnailBorderBrush" Color="#FF4A3B2E" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#661C1714" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFF3EAE1" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FFBCA996" />
    <SolidColorBrush x:Key="ButtonHoverOverlayBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="ButtonPressedOverlayBrush" Color="#33FFFFFF" />
</ResourceDictionary>
